{
  "name": "특허 현황 대시보드 (데모 v1)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",

  // 코드스페이스를 처음 만들 때 한 번: 라이브러리 설치 + DB 테이블 생성
  "postCreateCommand": "npm run setup",

  // KIPRIS 키는 GitHub Codespaces Secrets에 등록하면 환경변수로 들어온다 (파일로 올리지 않음)
  // 등록 방법: GitHub > Settings > Codespaces > Secrets > New secret (이름: KIPRIS_API_KEY)
  "secrets": {
    "KIPRIS_API_KEY": {
      "description": "KIPRIS Plus 인증키 (plus.kipris.or.kr). 없으면 새로고침 버튼이 동작하지 않습니다.",
      "documentationUrl": "https://plus.kipris.or.kr"
    }
  },

  // 화면(5173)만 브라우저로 열고, 백엔드(4000)는 화면이 내부에서 호출한다
  "forwardPorts": [5173, 4000],
  "portsAttributes": {
    "5173": { "label": "대시보드 화면", "onAutoForward": "openBrowser" },
    "4000": { "label": "API 서버", "onAutoForward": "silent" }
  }
}
