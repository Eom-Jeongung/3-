# 이 파일을 복사해서 backend/.env를 만들고 값을 채우세요. (.env는 GitHub에 올라가지 않음)
# KIPRIS Plus에서 발급받은 인증키
KIPRIS_API_KEY=
# 백엔드 포트. 천안 서버에서는 비워 두세요 → 자동으로 $PORT + 100 (user53이면 3153)
# 내 노트북에서는 4000
API_PORT=
DB_PATH=./data/patents.db
# AI 설정: 이 값들만 바꾸면 OpenRouter든 사내 AI 서버든 그대로 동작해요 (OpenAI 호환 주소)
# 예: AI_BASE_URL=https://openrouter.ai/api/v1
AI_BASE_URL=
# 사내 서버처럼 키가 필요 없으면 비워 두세요
AI_API_KEY=
AI_MODEL=
# AI 질문 하루 한도 (비우면 50회)
ASK_DAILY_LIMIT=
