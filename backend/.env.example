# 이 파일을 복사해서 backend/.env를 만들고 값을 채우세요. (.env는 GitHub에 올라가지 않음)
# KIPRIS Plus에서 발급받은 인증키
KIPRIS_API_KEY=
# 백엔드 포트. 천안 서버에서는 비워 두세요 → 자동으로 $PORT + 100 (user53이면 3153)
# 내 노트북에서는 4000
API_PORT=
DB_PATH=./data/patents.db
# AI 설정: 이 값들만 바꾸면 OpenRouter든 사내 AI 서버든 그대로 동작해요 (OpenAI 호환 주소)
# 예: AI_BASE_URL=https://openrouter.ai/api/v1
AI_BASE_URL=
# 사내 서버처럼 키가 필요 없으면 비워 두세요
AI_API_KEY=
AI_MODEL=
# 전체 수집(npm run collect) 한 번에 KIPRIS를 최대 몇 번 부를지 (비우면 300회, 월 무료 1,000회)
COLLECT_MAX_CALLS=
# 자동 갱신 주기(일). 마지막 갱신 후 이 일수가 지나면 서버가 스스로 새 특허를 받아와요
# 비우면 90일(분기), 0이면 자동 갱신을 꺼요. 서버가 켜져 있어야 동작해요
SYNC_INTERVAL_DAYS=
# 분기 자동 AI 요약: 1이면 분기마다(1·4·7·10월) 전체·방식·기술 분야 요약을 새로 만든다. 서버에서만 켜기 (노트북까지 켜면 무료 한도를 두 번 씀)
AUTO_SUMMARY=
# 배포 서버 접속 비밀번호. 넣으면 화면·API를 열 때 비밀번호를 묻는다 (노트북·천안 서버 개발에서는 비워 두기)
SITE_PASSWORD=
