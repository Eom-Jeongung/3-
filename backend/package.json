{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "sync": "node --env-file-if-exists=.env scripts/run-sync.js",
    "probe": "node --env-file-if-exists=.env scripts/probe-kipris.js",
    "collect": "node --env-file-if-exists=.env scripts/collect-full.js",
    "classify": "node --env-file-if-exists=.env scripts/run-classify.js",
    "predev": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')) fs.writeFileSync('.env','')\"",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js"
  },
